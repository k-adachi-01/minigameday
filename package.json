{
  "name": "minigameday",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm typecheck",
    "typecheck": "tsc && tsc -p dashboard",
    "watch": "tsc -w",
    "test": "vp test run",
    "test:watch": "vp test",
    "prepare": "lefthook install && pnpm symlinks",
    "symlinks": "tsx scripts/ensure-symlinks.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "dashboard": "vp dev dashboard --open",
    "dashboard:build": "vp build dashboard",
    "cdk": "cdk",
    "synth": "cdk synth",
    "synth:nag": "cdk synth -c nag=true --quiet",
    "diff": "cdk diff",
    "deploy": "cdk deploy --all",
    "destroy": "cdk destroy --all",
    "drift": "cdk drift",
    "reset": "tsx scripts/reset-gameday.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm synth",
    "agent:check": "pnpm check",
    "agent:predeploy": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm synth && pnpm diff"
  },
  "dependencies": {
    "@cdklabs/deploy-time-build": "^0.1.6",
    "aws-cdk-lib": "^2.258.1",
    "aws-icons": "^3.3.0",
    "constructs": "^10.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1090.0",
    "@aws-sdk/client-cloudformation": "^3.1089.0",
    "@aws-sdk/client-dynamodb": "^3.1085.0",
    "@aws-sdk/client-fis": "^3.1085.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-oxc": "^0.4.3",
    "@voidzero-dev/vite-plus-core": "^0.2.2",
    "aws-cdk": "2.1126.0",
    "cdk-nag": "^2.38.2",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.10",
    "oxfmt": "0.58.0",
    "oxlint-plugin-awscdk": "^0.1.3",
    "tsx": "^4.23.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.2",
    "vite-plus": "^0.2.2",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.10.0"
}
